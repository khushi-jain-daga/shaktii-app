{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!assets/|style.css|app.js|api.js|data.js|sw.js|manifest.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
